# `npm run dev:emulator` — talk to local Firebase emulators (start them with `npm run emulators`).
# Uses a demo- project id, so nothing ever touches your real Firebase project.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-mimilocks.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-mimilocks
VITE_FIREBASE_STORAGE_BUCKET=demo-mimilocks.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=1:0:web:0
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
