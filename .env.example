# ---- Optional ----
# Your public site address, used for share / invite links (especially inside
# the iOS app). Defaults to https://<project-id>.web.app in the app.
# VITE_PUBLIC_URL=https://mimilocks.example.com
# Force the offline demo backend even when Firebase is configured.
# VITE_BACKEND=local
# Use local Firebase emulators (see `npm run emulators`).
# VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
# TURN relay for voice channels on strict networks.
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
# Discord webhook for moderation alerts.
# VITE_DISCORD_WEBHOOK_URL=
