rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/User/$(request.auth.uid)); }
    // Site owners (keep in sync with src/lib/admin.js) are always admins and
    // are the only ones who can make or remove admins.
    function siteOwners() { return ['paologionfriddo90@gmail.com']; }
    function isSiteOwner() { return signedIn() && request.auth.token.email in siteOwners(); }
    function isAdmin() { return signedIn() && (isSiteOwner() || userDoc().data.role == 'admin'); }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function ownEmail() { return request.auth.token.email; }
    function ownsResource() {
      return signedIn() && (
        resource.data.created_by == ownEmail() ||
        resource.data.user_email == ownEmail() ||
        resource.data.owner_email == ownEmail() ||
        resource.data.artist_email == ownEmail() ||
        resource.data.requester_email == ownEmail()
      );
    }
    function ownsIncomingData() {
      return signedIn() && (
        request.resource.data.created_by == ownEmail() ||
        request.resource.data.user_email == ownEmail() ||
        request.resource.data.owner_email == ownEmail() ||
        request.resource.data.artist_email == ownEmail() ||
        request.resource.data.requester_email == ownEmail()
      );
    }
    // Every key the write adds, removes or changes must be in `fields`.
    // Muted by moderation (strikes, or an admin) until muted_until_ms: no posting.
    function mutedNow() {
      let me = /databases/$(database)/documents/User/$(request.auth.uid);
      return exists(me) && get(me).data.get('muted_until_ms', 0) > request.time.toMillis();
    }
    function onlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }
    function ownsCommunity(communityId) {
      return signedIn() && get(/databases/$(database)/documents/Community/$(communityId)).data.owner_email == ownEmail();
    }
    function managesCommunity(communityId) { return isAdmin() || ownsCommunity(communityId); }

    // ---- Likes -----------------------------------------------------------
    // One Like record per person per thing (id "<Collection>_<id>_<uid>") and
    // a like_count on the thing, which can only move by exactly one together
    // with that person's Like record being added or removed. The thing's
    // `likes` list is only a small sample of likers (faces, "liked by").
    function likeCollections() { return ['Artwork', 'CommunityPost', 'Reel', 'MusicReview']; }
    function thingPath(coll, id) { return /databases/$(database)/documents/$(coll)/$(id); }
    function likePath(coll, id) { return /databases/$(database)/documents/Like/$(coll + '_' + id + '_' + request.auth.uid); }
    // Numbers only the ranking job (or an admin) sets.
    function serverFields() { return ['like_count', 'rank_score', 'rank_updated', 'comment_count']; }
    function touches(fields) { return request.resource.data.diff(resource.data).affectedKeys().hasAny(fields); }
    function ownerEdit() { return ownsResource() && !touches(serverFields()); }
    // You can only add or take out yourself.
    function onlySelfInLikes() {
      let before = resource.data.get('likes', []).toSet();
      let after = request.resource.data.get('likes', []).toSet();
      return after.difference(before).hasOnly([ownEmail()]) && before.difference(after).hasOnly([ownEmail()]);
    }
    function likeWrite(coll, id) {
      let before = resource.data.get('like_count', 0);
      let after = request.resource.data.get('like_count', 0);
      return signedIn() && onlyChanged(['likes', 'like_count', 'updated_date', 'updated_at']) && onlySelfInLikes()
        && (('like_count' in resource.data)
          ? ((after == before + 1 && !exists(likePath(coll, id)) && existsAfter(likePath(coll, id)))
            || (after == before - 1 && exists(likePath(coll, id)) && !existsAfter(likePath(coll, id))))
          // Older things not counted yet: the list is still every liker.
          : !('like_count' in request.resource.data));
    }
    // New things start with no likes and no server numbers.
    function freshCounters() {
      return request.resource.data.get('like_count', 0) == 0
        && request.resource.data.get('likes', []).size() == 0
        && !request.resource.data.keys().hasAny(['rank_score', 'rank_updated', 'comment_count']);
    }
    function countMoves(data, by) {
      return getAfter(thingPath(data.target_type, data.target_id)).data.get('like_count', 0)
        == get(thingPath(data.target_type, data.target_id)).data.get('like_count', 0) + by;
    }

    match /Like/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.user_email == ownEmail()
        && request.resource.data.target_type in likeCollections()
        && id == request.resource.data.target_type + '_' + request.resource.data.target_id + '_' + request.auth.uid
        && countMoves(request.resource.data, 1);
      allow delete: if isAdmin() || (signedIn()
        && id == resource.data.target_type + '_' + resource.data.target_id + '_' + request.auth.uid
        && countMoves(resource.data, -1));
      allow update: if false;
    }

    // Numbers the ranking job keeps (read-only for everyone else).
    match /System/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /User/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid)
        && request.resource.data.email == ownEmail()
        && (request.resource.data.role == 'user' || isSiteOwner());
      // Owners can change anything, including who is an admin. Other admins
      // can edit people but not roles, and can't touch an owner's profile.
      allow update: if isSiteOwner()
        || (isAdmin() && !(resource.data.email in siteOwners())
            && request.resource.data.get('role', 'user') == resource.data.get('role', 'user'))
        || (isSelf(uid)
            && request.resource.data.email == resource.data.email
            && request.resource.data.role == resource.data.role
            // Only admins can ban or lift a ban.
            && request.resource.data.get('banned', false) == resource.data.get('banned', false)
            && request.resource.data.get('banned_until', '') == resource.data.get('banned_until', '')
            && request.resource.data.get('ban_reason', '') == resource.data.get('ban_reason', '')
            // Strikes and mutes only go up (admins can lift them).
            && request.resource.data.get('muted_until_ms', 0) >= resource.data.get('muted_until_ms', 0)
            && request.resource.data.get('mod_strikes', 0) >= resource.data.get('mod_strikes', 0));
      // Admins, or the person themselves when they delete their account.
      allow delete: if isSiteOwner() || isSelf(uid) || (isAdmin() && !(resource.data.email in siteOwners()));
    }

    match /SiteConfig/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /Log/{id} {
      allow read, write, delete: if isAdmin();
    }

    match /Artwork/{id} {
      allow read: if signedIn();
      allow create: if ownsIncomingData() && freshCounters() && !mutedNow();
      allow update: if isAdmin() || ownerEdit() || likeWrite('Artwork', id);
      allow delete: if isAdmin() || ownsResource();
    }

    match /CommunityPost/{id} {
      allow read: if signedIn();
      allow create: if ownsIncomingData() && freshCounters() && !mutedNow();
      allow update: if isAdmin() || ownerEdit() || likeWrite('CommunityPost', id);
      allow delete: if isAdmin() || ownsResource();
    }

    match /MusicReview/{id} {
      allow read: if signedIn();
      allow create: if ownsIncomingData() && freshCounters() && !mutedNow();
      // Anyone may like, or bump the play counter by exactly one.
      allow update: if isAdmin() || ownerEdit() || likeWrite('MusicReview', id)
        || (signedIn() && onlyChanged(['plays', 'updated_date', 'updated_at']) && request.resource.data.plays == resource.data.get('plays', 0) + 1);
      allow delete: if isAdmin() || ownsResource();
    }

    // Reels: short videos / photos. Anyone signed in can like, and bump the
    // view counter by exactly one; authors and admins edit or delete.
    match /Reel/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.user_email == ownEmail() && freshCounters() && !mutedNow();
      allow update: if isAdmin() || ownerEdit() || likeWrite('Reel', id)
        || (signedIn() && onlyChanged(['views', 'updated_date', 'updated_at']) && request.resource.data.views == resource.data.get('views', 0) + 1);
      allow delete: if isAdmin() || ownsResource();
    }

    // "What's new" notes written by admins, readable by everyone signed in.
    match /AppUpdate/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /Comment/{id} {
      allow read: if signedIn();
      allow create: if ownsIncomingData() && !mutedNow();
      // Anyone signed in can like a comment (only the likes change).
      allow update: if isAdmin() || ownsResource() || (signedIn() && onlyChanged(['likes', 'updated_date', 'updated_at']) && onlySelfInLikes());
      allow delete: if isAdmin() || ownsResource();
    }

    // Comments on reels have post_id "reel_<reel id>".
    function reelOf(postId) {
      return get(/databases/$(database)/documents/Reel/$(postId.replace('^reel_', '')));
    }
    function isReelComment(data) {
      return data.get('post_id', '') is string && data.get('post_id', '').matches('reel_.+');
    }

    match /CommunityComment/{id} {
      allow read: if signedIn();
      // No new comments on a reel whose creator turned comments off.
      allow create: if ownsIncomingData() && !mutedNow()
        && (!isReelComment(request.resource.data) || reelOf(request.resource.data.post_id).data.get('comments_off', false) != true);
      allow update: if isAdmin() || ownsResource() || (signedIn() && onlyChanged(['likes', 'updated_date', 'updated_at']) && onlySelfInLikes());
      // Profile owners moderate their message board (post_id "profile_<email>");
      // reel creators can remove comments on their reels.
      allow delete: if isAdmin() || ownsResource()
        || (signedIn() && resource.data.post_id == 'profile_' + ownEmail())
        || (signedIn() && isReelComment(resource.data) && reelOf(resource.data.post_id).data.user_email == ownEmail());
    }

    match /ProfileMessage/{id} {
      allow read: if signedIn();
      allow create: if ownsIncomingData() && !mutedNow();
      allow update, delete: if isAdmin() || ownsResource();
    }

    match /Commission/{id} {
      allow read: if signedIn();
      allow create: if ownsIncomingData() && !mutedNow();
      allow update, delete: if isAdmin() || ownsResource();
    }

    // ---- Servers -------------------------------------------------------
    // Moderation permissions come from roles; the app mirrors them into
    // Community.perm_index = { permission: [emails] } so rules can check them.
    function serverData(cid) { return get(/databases/$(database)/documents/Community/$(cid)).data; }
    function serverPermIn(c, perm) {
      return signedIn() && (isAdmin() || c.owner_email == ownEmail()
        || (ownEmail() in c.get('member_emails', []) && ownEmail() in c.get('perm_index', {}).get(perm, [])));
    }
    function hasServerPerm(cid, perm) { return serverPermIn(serverData(cid), perm); }
    function isServerMember(cid) { return signedIn() && (isAdmin() || ownEmail() in serverData(cid).get('member_emails', [])); }
    // Emails added to / removed from a server's member list by this write.
    function membersAdded() { return request.resource.data.member_emails.toSet().difference(resource.data.member_emails.toSet()); }
    function membersRemoved() { return resource.data.member_emails.toSet().difference(request.resource.data.member_emails.toSet()); }

    match /Community/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.owner_email == ownEmail() && !mutedNow();
      allow update: if isAdmin()
        || resource.data.owner_email == ownEmail()
        // Joining or leaving yourself.
        || (signedIn() && onlyChanged(['member_emails', 'updated_date', 'updated_at'])
            && membersAdded().union(membersRemoved()).hasOnly([ownEmail()]))
        // Kicking: remove others only.
        || (serverPermIn(resource.data, 'kick_members') && onlyChanged(['member_emails', 'updated_date', 'updated_at'])
            && membersAdded().size() == 0 && !(resource.data.owner_email in membersRemoved()))
        || (serverPermIn(resource.data, 'manage_server')
            && onlyChanged(['name', 'description', 'icon_emoji', 'icon_url', 'banner_url', 'welcome_message', 'updated_date', 'updated_at']))
        || (serverPermIn(resource.data, 'manage_roles')
            && onlyChanged(['perm_index', 'everyone_permissions', 'updated_date', 'updated_at']));
      allow delete: if isAdmin() || resource.data.owner_email == ownEmail();
    }

    match /ServerChannel/{id} {
      allow read: if signedIn();
      allow create: if hasServerPerm(request.resource.data.community_id, 'manage_channels');
      allow update, delete: if hasServerPerm(resource.data.community_id, 'manage_channels');
    }

    match /ServerRole/{id} {
      allow read: if signedIn();
      allow create: if hasServerPerm(request.resource.data.community_id, 'manage_roles');
      allow update, delete: if hasServerPerm(resource.data.community_id, 'manage_roles');
    }

    match /ServerMember/{id} {
      allow read: if signedIn();
      // You can create your own row (with no roles); role changes need Manage roles.
      allow create: if hasServerPerm(request.resource.data.community_id, 'manage_roles')
        || (signedIn() && request.resource.data.user_email == ownEmail() && request.resource.data.roles.size() == 0);
      allow update: if hasServerPerm(resource.data.community_id, 'manage_roles')
        || (signedIn() && resource.data.user_email == ownEmail()
            && onlyChanged(['nickname', 'user_display_name', 'user_profile_picture', 'updated_date', 'updated_at']));
      allow delete: if resource.data.user_email == ownEmail()
        || hasServerPerm(resource.data.community_id, 'kick_members')
        || hasServerPerm(resource.data.community_id, 'manage_roles');
    }

    match /ChannelMessage/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.user_email == ownEmail() && isServerMember(request.resource.data.community_id) && !mutedNow();
      allow update: if isAdmin()
        // Authors edit their own text (pinning needs permission).
        || (resource.data.user_email == ownEmail() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['is_pinned', 'user_email']))
        || hasServerPerm(resource.data.community_id, 'manage_messages')
        || (onlyChanged(['is_pinned', 'updated_date', 'updated_at']) && hasServerPerm(resource.data.community_id, 'pin_messages'))
        || onlyChanged(['reactions', 'thread_count', 'updated_date', 'updated_at']);
      allow delete: if isAdmin() || resource.data.user_email == ownEmail() || hasServerPerm(resource.data.community_id, 'manage_messages');
    }

    match /Friendship/{id} {
      allow read: if signedIn() && (resource.data.requester_email == ownEmail() || resource.data.receiver_email == ownEmail() || isAdmin());
      allow create: if signedIn() && request.resource.data.requester_email == ownEmail();
      allow update, delete: if isAdmin() || resource.data.requester_email == ownEmail() || resource.data.receiver_email == ownEmail();
    }

    match /GroupChat/{id} {
      allow read: if signedIn() && (ownEmail() in resource.data.member_emails || isAdmin());
      allow create: if signedIn() && ownEmail() in request.resource.data.member_emails;
      // Owners manage the group; any member may remove themselves (leave).
      allow update: if isAdmin() || resource.data.owner_email == ownEmail()
        || (signedIn() && ownEmail() in resource.data.member_emails
            && onlyChanged(['member_emails', 'member_display_names', 'updated_date', 'updated_at'])
            && !(ownEmail() in request.resource.data.member_emails));
      allow delete: if isAdmin() || resource.data.owner_email == ownEmail();
    }


    match /DirectMessage/{id} {
      allow read: if signedIn() && (ownEmail() in resource.data.member_emails || isAdmin());
      allow create: if signedIn()
        && ownEmail() in request.resource.data.member_emails
        && request.resource.data.user_email == ownEmail()
        && !mutedNow();
      allow update: if isAdmin()
        || (resource.data.user_email == ownEmail() && onlyChanged(['content', 'is_edited', 'read_by', 'reactions', 'updated_date', 'updated_at']))
        || (ownEmail() in resource.data.member_emails && onlyChanged(['read_by', 'reactions', 'updated_date', 'updated_at']));
      allow delete: if isAdmin() || resource.data.user_email == ownEmail();
    }

    match /ArtworkPing/{id} {
      allow read: if signedIn() && (resource.data.from_email == ownEmail() || resource.data.to_email == ownEmail() || isAdmin());
      allow create: if signedIn() && request.resource.data.from_email == ownEmail();
      allow update, delete: if isAdmin() || resource.data.from_email == ownEmail() || resource.data.to_email == ownEmail();
    }

    match /Notification/{id} {
      allow read, update, delete: if signedIn() && (resource.data.to_email == ownEmail() || isAdmin());
      allow create: if signedIn();
    }

    // Voice channels: one presence doc per connected peer + WebRTC signalling messages.
    match /VoicePresence/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.user_email == ownEmail();
      allow update: if signedIn() && resource.data.user_email == ownEmail() && request.resource.data.user_email == ownEmail();
      allow delete: if signedIn() && (resource.data.user_email == ownEmail() || resource.data.last_active < request.time.toMillis() - 60000);
    }

    match /VoiceSignal/{id} {
      allow read: if signedIn() && (resource.data.to_email == ownEmail() || resource.data.user_email == ownEmail());
      allow create: if signedIn() && request.resource.data.user_email == ownEmail();
      allow delete: if signedIn() && (resource.data.to_email == ownEmail() || resource.data.user_email == ownEmail());
    }

    // DM / group calls: the ringing + status doc shared by the call's members.
    match /Call/{id} {
      allow read: if signedIn() && (ownEmail() in resource.data.member_emails || isAdmin());
      allow create: if signedIn()
        && request.resource.data.caller_email == ownEmail()
        && ownEmail() in request.resource.data.member_emails;
      allow update: if isAdmin() || resource.data.caller_email == ownEmail()
        || (signedIn() && ownEmail() in resource.data.member_emails
            && onlyChanged(['status', 'declined_by', 'joined_emails', 'answered_at', 'ended_at', 'updated_date', 'updated_at']));
      allow delete: if isAdmin() || resource.data.caller_email == ownEmail();
    }

    // Reports of posts / people: anyone signed in can file one, only admins see them.
    match /Report/{id} {
      allow create: if signedIn() && request.resource.data.reporter_email == ownEmail();
      allow read, update, delete: if isAdmin();
    }

    // Invites: one record per new account (id = the new person's uid). The
    // inviter marks it claimed once when they collect their coins.
    match /Referral/{id} {
      allow read: if signedIn() && (resource.data.inviter_email == ownEmail() || resource.data.invitee_email == ownEmail() || isAdmin());
      allow create: if signedIn() && id == request.auth.uid
        && request.resource.data.invitee_email == ownEmail()
        && request.resource.data.inviter_email != ownEmail()
        && request.resource.data.claimed == false;
      allow update: if signedIn() && resource.data.inviter_email == ownEmail() && resource.data.claimed == false
        && request.resource.data.claimed == true && onlyChanged(['claimed', 'claimed_date']);
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
